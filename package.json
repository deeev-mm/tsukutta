{
  "name": "tsukutta",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @tsukutta/api --filter @tsukutta/web dev",
    "dev:web": "pnpm --filter @tsukutta/web dev",
    "dev:api": "pnpm --filter @tsukutta/api dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @tsukutta/api db:generate",
    "db:migrate:local": "pnpm --filter @tsukutta/api db:migrate:local",
    "db:seed:local": "pnpm --filter @tsukutta/api db:seed:local",
    "setup:local": "pnpm --filter @tsukutta/api setup:local",
    "typecheck": "pnpm -r typecheck"
  },
  "volta": {
    "node": "22.23.1"
  }
}
